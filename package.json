{
  "name": "video-master",
  "productName": "Video Master",
  "version": "1.5.0",
  "description": "RTSP, RTP, UDP, SRT, RTMP ve HLS ağ akışı görüntüleyici, çözümleyici ve kaydedici (Mastertool ailesi)",
  "main": "src/main.js",
  "author": "Video Master",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.js",
    "screenshots": "node scripts/screenshots.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "maplibre-gl": "^4.7.1",
    "onnxruntime-web": "^1.31.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.videomaster.app",
    "productName": "Video Master",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@napi-rs/**",
      "node_modules/@serialport/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Video-Master-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Video Master",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": {
      "artifactName": "Video-Master-Portable-${version}.exe"
    },
    "npmRebuild": false
  }
}
