{
  "name": "video-master",
  "productName": "Video Master",
  "version": "1.0.0",
  "description": "RTSP, RTP, UDP, SRT, RTMP ve HLS ağ akışı görüntüleyici, çözümleyici ve kaydedici (Mastertool ailesi)",
  "main": "src/main.js",
  "author": "Video Master",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.js",
    "screenshots": "node scripts/screenshots.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.videomaster.app",
    "productName": "Video Master",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/@napi-rs/**"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "Video-Master-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Video Master",
      "include": "build/installer.nsh",
      "menuCategory": "Master Tool"
    },
    "portable": { "artifactName": "Video-Master-Portable-${version}.exe" }
  }
}
